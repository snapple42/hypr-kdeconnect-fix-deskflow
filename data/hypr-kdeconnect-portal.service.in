[Unit]
Description=KDE Connect RemoteDesktop portal backend for virtual-input Wayland compositors
PartOf=xdg-desktop-portal.service

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.hypr_kdeconnect
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/hypr-kdeconnect-portal
Restart=on-failure
RestartSec=1s
# Filesystem sandboxing (PrivateTmp, ProtectSystem, ProtectHome) is deliberately
# absent: in a user manager those options force the service into a user namespace,
# which makes /proc/<pid>/exe of the calling app unreadable (EACCES) and therefore
# breaks the caller verification that gates input injection.
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
